{
  "name": "mistral-obsidian-plugin",
  "version": "0.1.0",
  "description": "Obsidian plugin: PDF-to-wiki ingest using Mistral OCR + Mistral chat models",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run"
  },
  "keywords": [
    "obsidian",
    "mistral",
    "ocr",
    "pdf",
    "wiki"
  ],
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.24.0",
    "obsidian": "^1.7.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.0"
  }
}
